{
  "description": "Shell commands and whether the MariaDB CLI guard must deny them. A command is denied only when it uses mariadb, mysql, mariadb-shell, mysqlsh or mariadb-dump for something an MCP tool covers. Every implementation of the guard (the bash hook for Claude Code and Codex, the Pi and OpenCode extensions, the Hermes plugin) is tested against this one list, plus one denied `mariadb-shell -- <object> <method>` call per entry of covered_shell_api.",
  "covered_shell_api": [
    "util.dump_instance", "util.dump_schemas", "util.dump_tables",
    "util.export_table", "util.load_dump", "util.import_table",
    "util.copy_instance", "util.copy_schemas", "util.copy_tables",
    "sandbox.deploy", "sandbox.start", "sandbox.stop", "sandbox.kill",
    "sandbox.delete",
    "msm.create_project", "msm.get_project_information",
    "msm.set_development_version", "msm.get_released_versions",
    "msm.get_last_released_version", "msm.get_last_deployment_version",
    "msm.prepare_release", "msm.get_sql_content_from_section",
    "msm.set_section_sql_content", "msm.generate_deployment_script",
    "msm.get_deployment_script_versions", "msm.deploy_schema",
    "mrs.dump_service", "mrs.load_service", "mrs.dump_service_project",
    "mrs.load_service_project", "mrs.load_content_set", "mrs.dump_audit_log",
    "mrs.dump_sdk_service_files"
  ],
  "deny": [
    "mariadb -uroot -psecret -h127.0.0.1 -P3411 < x.sql",
    "mariadb",
    "mysql -u root",
    "/opt/homebrew/bin/mariadb -e \"select 1\"",
    "mariadb.exe -e 1",
    "MYSQL_PWD=secret mariadb -e 'select 1'",
    "env MYSQL_PWD=x mariadb -e 1",
    "sudo mysql",
    "time mariadb -e 1",
    "cat data.sql | mariadb test",
    "cd /tmp && mariadb < load.sql",
    "true || mysql -e 1",
    "(mariadb -e 1)",
    "{ mariadb -e 1; }",
    "printf 'a\\n' && mysql -e 1",
    "mysql --version; mysql -e 1",
    "sh -c \"mysql -e \\\"select 1\\\"\"",
    "bash -lc 'mariadb -e \"select 1\"'",
    "eval \"mariadb -e 'select 1'\"",
    "echo $(mariadb -N -e \"select 1\")",
    "echo \"rows: $(mariadb -N -e 'select count(*) from t')\"",
    "echo `mysql -e 1`",
    "for v in 1 2 3; do mariadb -P341$v -e \"select version()\"; done",
    "if true; then mysql -e 1; fi",
    "mariadb-shell --sql -f script.sql",
    "mariadb-shell --sql root@127.0.0.1:3411 -f script.sql > out.txt 2>&1",
    "mariadb-shell root@127.0.0.1:3411 -e 'select 1'",
    "mariadb-shell -f script.sql",
    "mariadb-shell --file=script.sql",
    "mariadb-shell",
    "ls; mariadb-shell --sql -f a.sql",
    "mysqlsh --sql -e \"select 1\"",
    "mysqlsh root@localhost --sql < schema.sql",
    "mysqlsh -f schema.sql",
    "mariadb-shell root@127.0.0.1:3306 -- util dump-schemas sakila --outputUrl=/tmp/d",
    "mariadb-shell -- util dumpSchemas sakila --outputUrl=/tmp/d",
    "mariadb-shell -- util load-dump /tmp/d",
    "mariadb-shell -- sandbox deploy 3310",
    "mysqlsh -- util copy-instance mysql://root@other:3306",
    "mariadb-dump -uroot -psecret db | mariadb -h other db",
    "mariadb-dump db | mysql -h other db",
    "mariadb-dump --all-databases | gzip -c | mariadb other"
  ],
  "allow": [
    "ls -la",
    "cd ~/git/mariadb-shell && ls",
    "ls | grep mysql",
    "mariadb --version",
    "mysql -V",
    "mariadb --help",
    "mariadb -uroot --print-defaults",
    "mariadb-shell --version && echo ok",
    "mariadb-shell --help",
    "git commit -m \"fix mariadb client docs\"",
    "grep -rn \"mariadb -u\" docs",
    "grep -rn 'mysql -e' .",
    "printf 'a\\nmysql -e 1'",
    "echo 'run mariadb-dump yourself'",
    "brew install mariadb",
    "which mariadb",
    "command -v mariadb-shell",
    "type mysql",
    "cat ~/.my.cnf.mariadb",
    "python3 -m pytest tests/test_mariadb.py",
    "npm run mysql-setup",
    "docker pull mariadb:11.8",
    "vim mariadb.cnf",
    "echo mariadb",
    "mariadb-dump --no-data db > schema.sql",
    "mariadb-dump -uroot db | gzip > db.sql.gz",
    "nohup mariadb-dump db > d.sql &",
    "mariadb-dump db > d.sql || mariadb-dump --help",
    "mysqldump db > d.sql",
    "mariadb-admin -uroot status",
    "mariadb-import --local db data.csv",
    "mariadb-check --all-databases",
    "mariadb-binlog binlog.000001",
    "mariadb-shell -- mcp setup",
    "mariadb-shell -- mcp setup --addConnection",
    "mariadb-shell -- util check-for-server-upgrade root@localhost",
    "mariadb-shell --py -f check.py",
    "mariadb-shell -f check.py",
    "mariadb-shell --py -e 'print(1)'",
    "mysqlsh -e 'print(1)'",
    "mysqlsh -f setup.js",
    "mysqlsh -- dba deploy-sandbox-instance 3310",
    "mariadb-shell -- shell status"
  ]
}
