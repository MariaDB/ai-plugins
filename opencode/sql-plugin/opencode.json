{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["{env:MARIADB_SQL_PLUGIN}/plugins/mariadb-guard.ts"],
  "mcp": {
    "mariadb": {
      "type": "local",
      "command": ["{env:MARIADB_SQL_PLUGIN}/scripts/mariadb-mcp-launcher.sh"],
      "environment": {
        "MARIADB_SHELL_VERSION": "26.10.2"
      },
      "enabled": true
    }
  }
}
