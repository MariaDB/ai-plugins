# Batch files must keep CRLF endings: cmd.exe mis-parses `goto` labels and `^`
# line continuations in an LF-only .cmd, both of which the MCP launcher uses.
*.cmd text eol=crlf

# The extensionless launchers (Codex's MCP one, Claude Code's MCP and LSP ones)
# must stay LF: each is a shell script run through its shebang on macOS/Linux,
# and CRLF would make the kernel look for an interpreter named "bash\r". They
# match no *.sh rule, hence these.
mariadb-mcp-launcher text eol=lf
mariadb-lsp-launcher text eol=lf

# The Hermes launchers' committed copies of a mariadb-shell release's SHA256SUMS
# must stay LF: install.sh reads them line by line, and a CR would end up in
# every package name it compares.
*.SHA256SUMS text eol=lf
