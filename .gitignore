# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Test + coverage output (run_tests.py)
.coverage
.coverage.*
htmlcov/
test-results/

# Local env
.env

# Node / pi extensions (pi install runs `npm install` into the plugin dir)
node_modules/
package-lock.json

# Jekyll (docs/ — GitHub Pages builds it, the output is never committed)
docs/_site/
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/Gemfile.lock
docs/vendor/

# macOS Finder
.DS_Store

# Docusaurus preview of the reference docs (docs-ref/) — build output and cache.
# Its lockfile is kept, unlike the pi package's above, for reproducible builds.
docs-ref/build/
docs-ref/.docusaurus/
!docs-ref/package-lock.json
